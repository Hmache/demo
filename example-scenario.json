{
  "url": "https://app.example.com/",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "voice": {
    "engine": "kokoro",
    "voice": "af_heart",
    "lang": "en-us"
  },
  "captions": true,
  "steps": [
    {
      "say": "This is a simple task manager. Let's add a few things to do.",
      "actions": []
    },
    {
      "say": "First, we type a new task and press Enter.",
      "actions": [
        {
          "type": "click",
          "selector": "input.new"
        },
        {
          "type": "type",
          "selector": "input.new",
          "text": "Record the product demo"
        },
        {
          "type": "press",
          "key": "Enter"
        }
      ]
    },
    {
      "say": "We add a second one the same way.",
      "actions": [
        {
          "type": "type",
          "selector": "input.new",
          "text": "Send it to the client"
        },
        {
          "type": "press",
          "key": "Enter"
        }
      ]
    },
    {
      "say": "Checking the box marks a task as done.",
      "actions": [
        {
          "type": "click",
          "selector": "#list li >> nth=0 >> .toggle"
        }
      ]
    },
    {
      "say": "And the Completed filter shows only finished tasks.",
      "actions": [
        {
          "type": "click",
          "selector": "button:has-text('Completed')"
        }
      ]
    }
  ]
}